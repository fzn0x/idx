rastructure Small Caps"},"outstandingPercent":0.0,"percentPortfolio":0.0,"marketValue":21436293.0,"reportDate":"2026-03-31T00:00:00Z"},{"shares":0.0,"sharesChange":-430200.0,"rank":5,"change":-14742.0,"changePercent":-0.0063,"entity":{"displayName":"Pheim Income Fund"},"outstandingPercent":0.0,"percentPortfolio":0.0,"marketValue":335499.0,"reportDate":"2025-12-31T00:00:00Z"}],"mutualFundOwnershipPercent":0.11,"top10InstitutesPercent":0.11},"optionChainMaturityDates":[],"securityDescription":"JASUINDO TIGA PE ORD","assetCategory":"ORD","assetClass":"","exchangeId":"r6dwod","exchangeCode":"XIDX","exchangeName":"Indonesia Stock Exchange","offeringStatus":"regular","displayName":"Jasuindo Tiga Perkasa Tbk PT","shortName":"Jasuindo Tiga","securityType":"stock","instrumentId":"bkgwu2","symbol":"JTPE","country":"ID","market":"id-id","localizedAttributes":{"en-us":{"displayName":"PT Jasuindo Tiga Perkasa Tbk","description":"PT Jasuindo Tiga Perkasa Tbk is an Indonesia-based company, which is engaged in the integrated trading document industry, such as document printing and printing support services. The Company’s segments include Security documents and Non-security documents. The Security documents are products that are secured in nature and require a special permit during the production. The Non-security documents are products that are not secured in nature and do not require special permission, forms, redemption coupons and more. The Company’s products are categorized into identity, payment, brand protection, and commercial printing. The identity products are official identifications such as Identity (ID) cards, driver’s license, passports, and others. The payment products offer card manufacturing services, as well as providing security features and card materials using processing tools and equipment. The brand protection provides a tax stamp management solution."},"de-de":{"displayName":"PT Jasuindo Tiga Perkasa Tbk","description":"PT Jasuindo Tiga Perkasa Tbk ist ein in Indonesien ansässiges Unternehmen, das integrierte Geschäftsdokumentprodukte und Dienstleistungen bereitstellt. Das Geschäft ist in zwei operative Segmente eingeteilt: sicherheitsrelevante Produkte und nicht sicherheitsrelevante Produkte. Das erste Segment umfasst Dokumente, die eine besondere Erlaubnis zur Herstellung benötigen, wie Scheckbücher, Kreditkarten und Aktienzertifikate; das zweite umfasst diejenigen Dokumente, die ohne Genehmigung hergestellt werden können, wie Formulare, Abrechnungen und Gutscheineinlösungen. Die Anlagen des Unternehmens befinden sich in Sidoarjo, Indonesien, und Tangerang, Indonesien. Seine Tochterunternehmen umfassen PT Jasuindo Informatika Pratama, PT Cardsindo Tiga Perkasa und PT Jasuindo Arjowiggins Security."},"id-id":{"displayName":"PT Jasuindo Tiga Perkasa Tbk","description":"PT Jasuindo Tiga Perkasa Tbk merupakan perusahaan di Indonesia yang bergerak dalam bidang penyediaan produk dan layanan dokumen bisnis terintegrasi. Usaha diklasifikasikan ke dalam dua segmen operasi, yaitu produk sekuritas dan non-sekuritas. Segmen sekuritas terdiri dari dokumen yang memerlukan izin khusus untuk produksinya, seperti buku cek, kartu kredit, dan sertifikat saham; segmen non-sekuritas terdiri dari dokumen yang dapat diproduksi tanpa memerlukan izin, seperti formulir, laporan tagihan, dan kupon penebusan. Pabrik perusahaannya terletak di Sidoarjo, Indonesia dan Tangerang, Indonesia. Anak perusahaannya termasuk PT Jasuindo Informatika Pratama, PT Cardsindo Tiga Perkasa, dan PT Jasuindo Arjowiggins Security."},"ja-jp":{"displayName":"ジャスインド・ティガ・プルカサ","description":"ジャスインド・ティガ・プルカサ（Jasuindo Tiga Perkasa Tbk PT）はインドネシアに本社を置く企業で、文書印刷や印刷支援サービスなどの総合取引文書産業を展開する。【事業内容】セグメントには、セキュリティー文書と非セキュリティー文書がある。セキュリティー・ドキュメントは、性質上セキュリティーが確保された製品であり、製造時に特別な許可を必要とする。非セキュリティー・ドキュメントは、本質的にセキュリティーで保護されておらず、特別な許可を必要としない製品、帳票、引き換えクーポンなどである。製品は、ID、決済、ブランド保護、商業印刷に分類される。ID製品は、IDカード、運転免許証、パスポートなどの公的身分証明書である。ペイメント製品は、カード製造サービスを提供し、加工ツールや機器を使用してセキュリティ機能やカード素材を提供する。ブランド保護は、印紙税管理ソリューションを提供する。"}},"timeLastUpdated":"2026-11-05T11:04:06.9020926Z","currency":"IDR","_p":"bkgwu2","id":"ae7845d5-3645-4d17-98d6-6a1c3df2fcbd","_t":"Equity"}]