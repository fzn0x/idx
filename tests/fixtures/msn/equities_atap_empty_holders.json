"enterpriseValue":446884200000.0}},"beta":2.1542,"company":{"address":{"street":"Jl. H. Junaedi No.1 RT 12 RW 03, Cipete Selatan, Kec. Cilandak, Kota Jakarta Selatan,","city":"JAKARTA SELATAN","state":"DKI JAKARTA","zip":"12410","country":"Indonesia","countryCode":"ID","phone":"+62 21 27813852"},"directors":[],"description":"PT Trimitra Prawara Goldland Tbk is an Indonesia-based company operating in the real estate development and management sector. The Company focuses on building and developing subsidized and middle-class residential areas. It operates through two business segments: Sale of Houses and Rent. The Company’s projects include Cibungbulang Town Hill (CITOH) and Bumi Abhirama Residence (BAR). CITOH is a subsidized and commercial mixed residential area in Bogor, covering approximately 100 hectares. CITOH offers a one-stop destination concept, integrating residential areas with tourist destinations and business centers. BAR is a residential project with a tropical living concept in the Sunrise Sawangan area of Depok, providing easy access to Jakarta via the DESARI Toll Road or Citayam Station. The area is equipped with facilities such as a mezzanine, outdoor fitness area, playground, mosque, underground utilities, and smart homes. ","employees":4,"industry":"Homebuilding & Construction Supplies","name":"Trimitra Prawara Goldland Tbk PT","sector":"Consumer Cyclicals","style":"5320301010","type":"5320301010","website":"https://trimitraprawaraland.co.id/"},"relatedStocks":[{"instrumentId":"bkgqvh","displayName":"Perdana Gapura Prima Tbk PT","shortName":"Perdana Gapura","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"GPRA"},{"instrumentId":"bkgptc","displayName":"Gema Grahasarana Tbk PT","shortName":"Gema Grahasarana","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"GEMA"},{"instrumentId":"caj5ur","displayName":"Minahasa Membangun Hebat Tbk PT","shortName":"Minahasa","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"HBAT"},{"instrumentId":"bkgqk2","displayName":"Gowa Makassar Tourism Development Tbk PT","shortName":"Gowa Makassar","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"GMTD"},{"instrumentId":"c9cy5r","displayName":"Pt Oxala Energy International Tbk","shortName":"Pt Oxala Energy","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"PIPA"},{"instrumentId":"bkgsww","displayName":"Intikeramik Alamasri Industri Tbk PT","shortName":"Intikeramik Alam","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"IKAI"},{"instrumentId":"cf6abh","displayName":"Adiwarna Anugerah Abadi PT Tbk","shortName":"Adiwarna Anugera","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"NAIK"},{"instrumentId":"bkfffr","displayName":"Arwana Citramulia Tbk PT","shortName":"Arwana","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"ARNA"},{"instrumentId":"bh4tpr","displayName":"Surya Pertiwi Tbk PT","shortName":"Surya Pertiwi","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"SPTO"},{"instrumentId":"bkhvsm","displayName":"Surya Toto Indonesia Tbk PT","shortName":"Surya Toto ID","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"TOTO"},{"instrumentId":"bne4c7","displayName":"Cahayaputra Asa Keramik Tbk PT","shortName":"Cahayaputra Asa","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"CAKK"},{"instrumentId":"bgw8lh","displayName":"Keramika Indonesia Assosiasi Tbk PT","shortName":"Keramika ID","exchangeId":"r6dwod","exchangeCode":"XIDX","securityType":"stock","symbol":"KIAS"}],"ownershipSummary":{"floatOwnershipPercent":15.0635,"insiderOwnershipPercent":8.94,"institutionalOwnership":[],"mutualFundOwnership":[]},"optionChainMaturityDates":[],"securityDescription":"TRIMITRA PRAWARA ORD","assetCategory":"ORD","assetClass":"","exchangeId":"r6dwod","exchangeCode":"XIDX","exchangeName":"Indonesia Stock Exchange","offeringStatus":"regular","displayName":"Trimitra Prawara Goldland Tbk PT","shortName":"Trimitra Prawara","securityType":"stock","instrumentId":"bwzup2","symbol":"ATAP","country":"ID","market":"id-id","localizedAttributes":{"en-us":{"displayName":"PT TRIMITRA PRAWARA GOLDLAND Tbk.","description":"PT Trimitra Prawara Goldland Tbk is an Indonesia-based company operating in the real estate development and management sector. The Company focuses on building and developing subsidized and middle-class residential areas. It operates through two business segments: Sale of Houses and Rent. The Company’s projects include Cibungbulang Town Hill (CITOH) and Bumi Abhirama Residence (BAR). CITOH is a subsidized and commercial mixed residential area in Bogor, covering approximately 100 hectares. CITOH offers a one-stop destination concept, integrating residential areas with tourist destinations and business centers. BAR is a residential project with a tropical living concept in the Sunrise Sawangan area of Depok, providing easy access to Jakarta via the DESARI Toll Road or Citayam Station. The area is equipped with facilities such as a mezzanine, outdoor fitness area, playground, mosque, underground utilities, and smart homes."},"ja-jp":{"displayName":"トリミトラー・プラワーラー・ゴールドランド","description":"トリミトラー・プラワーラー・ゴールドランド（PT TRIMITRA PRAWARA GOLDLAND Tbk.）は、インドネシアを拠点とする不動産開発・管理である。【事業内容】低所得者向け住宅補助金対象住宅および中所得者向け住宅地の建設・開発を主軸とする。事業は住宅販売と賃貸の2つのセグメントで構成する。主なプロジェクトには、Cibungbulang Town Hill（CITOH）やBumi Abhirama Residence（BAR）がある。CITOHはボゴールに位置する総面積約100ヘクタールの開発地で、補助金対象住宅と商業施設を併設した複合型住宅エリアである。住宅地に観光スポットやビジネスセンターを融合させたワンストップ・デスティネーションのコンセプトを促進する。一方、BARはデポック市のSunrise Sawanganエリアで展開される、トロピカルな居住空間をコンセプトとした住宅プロジェクトである。DESARI有料道路やチタヤム（Citayam）駅を利用することで、ジャカルタへのアクセスも良好である。エリアには、中二階メザニン構造の住居、屋外フィットネスエリア、遊び場、モスク、地下埋設型インフラ、スマートホーム設備などが整備する。"}},"timeLastUpdated":"2026-11-05T11:05:56.297126Z","currency":"IDR","_p":"bwzup2","id":"c14d7768-9180-4f03-84b3-b741be726c06","_t":"Equity"}]